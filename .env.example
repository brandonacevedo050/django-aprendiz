# Copia este archivo a ".env" para correr Django directo en tu máquina
# (sin Docker). Cuando el backend corre DENTRO de Docker, estas
# variables las define docker-compose.yml directamente y este archivo
# no se usa para eso.
#
# Si el MySQL al que te conectas es el del docker-compose (contenedor
# mysql_django), usa el puerto PUBLICADO al host, no el interno:
#   DB_PORT=3307   <- puerto mapeado en docker-compose.yml (host:contenedor)
#
# Si en tu máquina tienes OTRO MySQL nativo (instalado aparte, fuera
# de Docker) escuchando en el 3306, y quieres usar ESE en vez del de
# Docker, cambia DB_PORT a 3306 y asegúrate de que exista la base
# 'aprendiz' y las credenciales coincidan ahí también.

DATABASE_ENGINE=mysql
DB_ENGINE=mysql
DB_HOST=localhost
DB_PORT=3307
DB_NAME=aprendiz
DB_USER=root
DB_PASSWORD=root

MONGODB_URI=mongodb://localhost:27017
MONGODB_NAME=aprendiz

DJANGO_DEBUG=true
DJANGO_SECRET_KEY=change-me-in-production
DJANGO_ALLOWED_HOSTS=*

CORS_ALLOWED_ORIGINS=http://localhost:5173

